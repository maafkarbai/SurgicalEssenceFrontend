<%- include('head', {title:'Product preview'}) %><p class="notice">Private preview. This product is <%= product.status %>.</p><section class="panel"><h2><%= product.name %></h2><p><%= product.code %></p><% if(product.image) { %><img class="preview-image" src="<%= product.image %>" alt="<%= product.alt || product.name %>"><% } %><p class="preserve"><%= product.description || product.shortDescription %></p><h3>Specifications</h3><p class="preserve"><%= product.specifications %></p></section><%- include('foot') %>
