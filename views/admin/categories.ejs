<%- include('head', {title:'Categories'}) %><div class="editor-grid"><section class="panel table-wrap"><table><thead><tr><th>Name</th><th>Slug</th><th>Priority</th><th>Actions</th></tr></thead><tbody><% categories.forEach(c=> { %><tr><td><%= c.name %> <%= c.status==='archived'?'(archived)':'' %></td><td><%= c.slug %></td><td><%= c.priority || 0 %></td><td class="actions"><a href="/admin/categories/<%= c.id %>/edit">Edit</a><a class="danger" href="/admin/categories/<%= c.id %>/archive">Archive</a></td></tr><% }) %></tbody></table></section><section class="panel"><h2><%= category.id?'Edit category':'Add category' %></h2><form method="post" action="/admin/categories/save" data-dirty-form><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= category.id || '' %>"><input type="hidden" name="revision" value="<%= category.revision || '' %>"><% [['name','Name'],['slug','URL slug'],['imageUrl','Image URL']].forEach(([key,label])=> { %><label><%= label %><input name="<%= key %>" value="<%= category[key] || '' %>" <%= key==='name'?'required':'' %> maxlength="1000"></label><% }) %><label>Description<textarea name="description" rows="4"><%= category.description || '' %></textarea></label><label>Display priority<input type="number" name="priority" min="0" max="999999" value="<%= category.priority || 0 %>"></label><button>Save category</button><a href="/admin/categories">Clear</a><p class="muted">Categories containing active products cannot be archived. Upload an optional image in the Media Library and use its URL here.</p></form></section></div><%- include('foot') %>
