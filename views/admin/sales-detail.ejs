<%- include('head',{title:'Enquiry '+enquiry.id}) %>
<p><a href="/admin/<%= kind %>">← Back to <%= kind==='quotes'?'quotations':'leads' %></a></p>
<section class="panel"><h2>Enquiry requirements</h2><dl><dt>Enquiry intent</dt><dd><%= enquiry.intent %></dd><dt>Distribution territory</dt><dd><%= enquiry.territory || 'Not supplied' %></dd><dt>Instrument interests</dt><dd><pre><%= enquiry.interests || 'Not supplied' %></pre></dd><dt>Purchasing requirements</dt><dd><pre><%= enquiry.purchasing || 'Not supplied' %></pre></dd></dl></section>
<section class="panel"><h2>Buyer information</h2><dl><dt>Name</dt><dd><%= enquiry.name %></dd><dt>Company</dt><dd><%= enquiry.company %></dd><dt>Email</dt><dd><%= enquiry.email %></dd><dt>Country</dt><dd><%= enquiry.country %></dd><dt>Phone</dt><dd><%= enquiry.phone || 'Not supplied' %></dd><dt>Buyer type</dt><dd><%= enquiry.buyerType %></dd><dt>Received (UTC)</dt><dd><%= new Date(enquiry.createdAt).toISOString() %></dd></dl></section>
<section class="panel"><h2>Requested instruments</h2><% if(enquiry.items.length){ %><table><thead><tr><th>Reference</th><th>Quantity</th></tr></thead><tbody><% enquiry.items.forEach(item=>{ %><tr><td><%= item.code || item.sku || '' %></td><td><%= item.quantity ?? 'To discuss' %></td></tr><% }) %></tbody></table><% } %><dl><dt>Products</dt><dd><pre><%= enquiry.products %></pre></dd><dt>Quantities</dt><dd><pre><%= enquiry.quantities %></pre></dd><dt>OEM / private label</dt><dd><pre><%= enquiry.oem %></pre></dd><dt>Message</dt><dd><pre><%= enquiry.message %></pre></dd></dl></section>
<section class="panel"><h2>Sales pipeline</h2><form method="post" action="/admin/<%= kind %>/<%= encodeURIComponent(enquiry.id) %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Status<select name="status"><% statuses.forEach(status=>{ %><option <%= enquiry.status===status?'selected':'' %>><%= status %></option><% }) %></select></label><label>Internal notes<textarea name="notes" rows="6" maxlength="10000"><%= enquiry.notes %></textarea></label><button>Save pipeline</button></form><% if(enquiry.updatedAt){ %><p>Last updated by <%= enquiry.updatedBy %> at <%= new Date(enquiry.updatedAt).toISOString() %>.</p><% } %></section>
<section class="panel"><h2>Pipeline history</h2><% if(!enquiry.audit.length){ %><p>No updates yet.</p><% }else{ %><ol><% enquiry.audit.forEach(entry=>{ %><li><p><%= entry.previousStatus %> → <%= entry.status %> · <%= entry.actor %> · <%= new Date(entry.createdAt).toISOString() %></p><pre><%= entry.notes %></pre></li><% }) %></ol><% } %></section>
<%- include('foot') %>
