<%- include('head', {title:product.id?'Edit product':'Add product'}) %><form method="post" action="/admin/products/save" data-dirty-form><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= product.id || '' %>"><input type="hidden" name="revision" value="<%= product.revision || '' %>"><div class="editor-grid"><div><section class="panel"><h2>Basic information</h2><% [['name','Product name',true],['code','SKU / reference number',true]].forEach(([key,label,required])=> { %><label><%= label %><input name="<%= key %>" value="<%= product[key] || '' %>" required maxlength="200"><% if(errors[key]) { %><span class="field-error"><%= errors[key] %></span><% } %></label><% }) %><label>Category<select name="categoryId" required><option value="">Choose a category</option><% categories.filter(c=>c.status!=='archived'||c.id===product.categoryId).forEach(c=> { %><option value="<%= c.id %>" <%= product.categoryId===c.id||product.category===c.slug?'selected':'' %>><%= c.name %></option><% }) %></select></label><% [['shortDescription','Short description',3],['description','Full description',7],['specifications','Specifications',5]].forEach(([key,label,rows])=> { %><label><%= label %><textarea name="<%= key %>" rows="<%= rows %>" maxlength="20000"><%= product[key] || '' %></textarea></label><% }) %></section><section class="panel"><h2>Technical information</h2><p class="muted">Add verified details only. Optional fields can remain blank.</p><div class="two-cols"><% [['material','Material'],['length','Size / dimensions'],['variations','Available variations'],['type','Instrument type'],['pattern','Pattern'],['page','Catalogue page']].forEach(([key,label])=> { %><label><%= label %><input name="<%= key %>" value="<%= product[key] || '' %>" maxlength="2000"></label><% }) %></div><label>Technical notes<textarea name="notes" rows="4" maxlength="10000"><%= product.notes || '' %></textarea></label></section><section class="panel"><h2>Product images</h2><p class="muted">JPEG, PNG or WebP. The first image is the primary image. Save the product to keep image changes.</p><label>Upload images<input type="file" accept="image/jpeg,image/png,image/webp" multiple data-image-upload></label><p role="status" data-upload-status></p><input type="hidden" name="images" value="<%= JSON.stringify(Array.isArray(product.images)?product.images:[]) %>" data-images><div class="image-editor" data-image-editor></div><details><summary>Choose from media library</summary><button type="button" class="secondary" data-open-library>Load available images</button><div data-library-picker></div></details></section><section class="panel"><h2>Search engine information</h2><% [['slug','URL slug'],['seoTitle','SEO title'],['metaDescription','Meta description'],['alt','Default image alt text']].forEach(([key,label])=> { %><label><%= label %><input name="<%= key %>" value="<%= product[key] || '' %>" maxlength="<%= key==='metaDescription'?320:200 %>"></label><% }) %><p class="muted">Blank values receive defaults based on the product name. Existing URLs redirect when a slug changes.</p></section></div><aside><section class="panel publishing"><h2>Publishing</h2><p class="muted">Source review: <strong><%= product.verification?.status==='verified'?'Verified':'Unreviewed' %></strong>. Existing publication does not establish source verification.</p><% if(product.verification?.status==='verified'){ %><p class="muted">Reviewed by <%= product.verification.reviewedBy %> on <%= new Date(product.verification.reviewedAt).toISOString() %>.</p><% } %><details open><summary>Source evidence and review</summary><p class="muted">Compare the reference, name, dimensions, specifications and images with the source. Review confirms source accuracy, not regulatory approval. Content or image changes require another review.</p><% [['sourceDocument','Source document / revision',1000],['sourcePage','Source PDF page',5],['imageEvidence','Image evidence / source match',2000],['reviewNotes','Source review notes',4000]].forEach(([key,label,max])=>{ %><label><%= label %><input name="<%= key %>" value="<%= product[key] || '' %>" maxlength="<%= max %>" <%- key==='sourcePage'?'type="number" min="1" max="10000"':'' %>></label><% }) %><label for="source-review-action">Source review action</label><select id="source-review-action" name="reviewAction"><option value="keep">Keep current review</option><option value="verify">Record source review for this save</option><option value="revoke">Revoke source review</option></select></details><label>Status<select name="status"><% ['draft','published',...(product.status==='archived'?['archived']:[])].forEach(s=> { %><option <%= product.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label class="check"><input type="checkbox" name="featured" <%= product.featured?'checked':'' %>> Featured product</label><label>Display priority<input type="number" name="priority" min="0" max="999999" value="<%= product.priority || 0 %>"></label><p class="muted">Lower priorities appear first.</p><button class="wide">Save product</button><% if(product.id) { %><a class="button secondary wide" href="/admin/preview/<%= product.id %>" target="_blank" rel="noopener">Preview saved product ↗</a><a class="danger" href="/admin/products/<%= product.id %>/archive">Archive product</a><% } %><a href="/admin/products">Back to products</a></section></aside></div></form><%- include('foot') %>
