<%- include('head', {title:'Dashboard'}) %><div class="toolbar"><p class="muted">Manage your instrument catalogue and publishing.</p><a class="button" href="/admin/products/new">Add product</a></div><div class="stats"><div><span>Total products</span><strong><%= all.total %></strong></div><div><span>Published</span><strong><%= published.total %></strong></div><div><span>Drafts</span><strong><%= drafts.total %></strong></div><div><span>Categories</span><strong><%= categories.filter(c => c.status !== 'archived').length %></strong></div></div><section class="panel"><h2>Recent product updates</h2><% if(!all.items.length) { %><p>No products yet. Add your first instrument.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU</th><th>Status</th><th>Updated</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody><% all.items.forEach(p=> { %><tr><td><%= p.name %></td><td><%= p.code %></td><td><span class="badge"><%= p.status %></span></td><td><%= p.updatedAt ? new Date(p.updatedAt).toLocaleDateString('en-GB') : '—' %></td><td><a href="/admin/products/<%= p.id %>/edit">Edit</a></td></tr><% }) %></tbody></table></div><% } %></section>
<% if(typeof sales!=="undefined"&&sales){ %><section class="panel"><h2>Business enquiries</h2><div class="stats"><div><span>Total enquiries</span><strong><%= sales.total %></strong></div><div><span>New</span><strong><%= sales.NEW %></strong></div><div><span>In negotiation</span><strong><%= sales.NEGOTIATION %></strong></div><div><span>Closed</span><strong><%= sales.CLOSED %></strong></div></div><a class="button" href="/admin/quotes">Review quotations</a></section><% } %>
<%- include('foot') %>
