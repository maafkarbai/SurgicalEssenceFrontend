<%- include('head',{title:'Subscriber preferences'}) %><p>Only explicit website opt-ins appear here. Email campaigns are not sent by this dashboard. Honour inactive preferences before sending through any provider.</p><div class="table-wrap"><table><thead><tr><th>Email</th><th>Preference</th><th>Consent recorded</th><th>Updated</th></tr></thead><tbody><% for(const item of subscribers){ %><tr><td><%= item.email %></td><td><%= item.active?'Opted in':'Inactive' %></td><td><%= new Date(Number(item.consent_at)).toISOString() %></td><td><%= new Date(Number(item.updated_at)).toISOString() %></td></tr><% } %></tbody></table><% if(!subscribers.length){ %><p>No subscriber preferences yet.</p><% } %></div><%- include('foot') %>
