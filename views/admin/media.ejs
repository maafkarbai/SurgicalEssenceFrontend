<%- include('head', {title:'Media Library'}) %><section class="panel"><h2>Upload images</h2><label>JPEG, PNG or WebP<input type="file" multiple accept="image/jpeg,image/png,image/webp" data-library-upload></label><p data-upload-status role="status"></p></section><div class="media-grid"><% images.forEach(m=> { %><article class="panel media-item"><img src="<%= m.smallUrl || m.url %>" alt="<%= m.alt || '' %>" loading="lazy"><label>Image URL<input readonly value="<%= m.url %>" aria-label="Image URL"></label><label>CSV import reference<input readonly value="id:<%= m.id %>" aria-label="CSV import reference"></label><p><%= m.width || '' %> × <%= m.height || '' %></p><button class="secondary danger" type="button" data-delete-media="<%= m.id %>">Delete unused image</button></article><% }) %><% if(!images.length) { %><p>No uploaded images yet.</p><% } %></div><%- include('foot') %>
