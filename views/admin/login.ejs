<!doctype html><html lang="en"><head><meta name="color-scheme" content="light"><meta name="theme-color" content="#ffffff"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Admin login | Surgical Essence</title><link rel="stylesheet" href="/admin.css"></head><body class="login-page"><main class="login"><div class="brand">SURGICAL ESSENCE<span>Private catalogue administration</span></div><h1>Sign in</h1><% if(error) { %><div class="notice error" role="alert"><%= error %></div><% } %><form method="post" action="/admin/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Email<input type="email" name="email" required autocomplete="username" maxlength="254" value="<%= typeof email !== 'undefined' ? email : '' %>"></label><label>Password<input type="password" name="password" required autocomplete="current-password" maxlength="256"></label><button>Sign in</button></form><p class="muted">Access is restricted to authorised administrators.</p></main></body></html>
