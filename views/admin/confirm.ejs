<%- include('head', {title:'Confirm archive'}) %><section class="panel narrow"><h2>Archive <%= item.name %>?</h2><p><%= kind==='products'?'The product will be removed from the public catalogue. Historical quotation details will remain available.':'A category containing active products cannot be archived. Move its products first.' %></p><form method="post" action="/admin/<%= kind %>/<%= item.id %>/archive"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger-button">Archive <%= kind==='products'?'product':'category' %></button><a class="button secondary" href="/admin/<%= kind %>">Cancel</a></form></section><%- include('foot') %>
