<article class="product-card">
 <a class="product-image" href="/products/<%= encodeURIComponent(p.slug || p.code) %>" aria-label="View <%= p.name %>, <%= p.code %>"><% if(p.image){ %><img src="<%= p.images?.[0]?.mediumUrl || p.image %>" <% if(p.images?.[0]?.smallUrl && p.images?.[0]?.mediumUrl){ %>srcset="<%= p.images[0].smallUrl %> 400w, <%= p.images[0].mediumUrl %> 800w" sizes="(max-width: 640px) 45vw, 30vw"<% } %> alt="<%= p.images?.[0]?.alt || p.alt || p.name %>" width="280" height="280" loading="lazy"><% }else{ %><span class="muted">Image not yet available</span><% } %></a>
 <div class="product-content"><span class="product-type"><%= p.type %> · <%= p.length %></span><h3><a href="/products/<%= encodeURIComponent(p.slug || p.code) %>"><%= p.name %></a></h3><code><%= p.code %></code><div class="product-actions"><a href="/products/<%= encodeURIComponent(p.slug || p.code) %>">View details <%- include('icon',{name:'arrow-right',size:'small'}) %></a><button class="add-button" data-add="<%= p.code %>" data-name="<%= p.name %>" data-slug="<%= p.slug || p.code %>" data-image="<%= p.image || '' %>" aria-label="Add <%= p.name %>, <%= p.code %> to quote list"><%- include('icon',{name:'quote-list',size:'small'}) %><span>Quote list</span></button></div></div>
</article>
