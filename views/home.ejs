<% const heroProduct=products.find(p=>p.code==='010-070-13') || products.find(p=>p.featured) || products[0]; %>
<section class="hero container">
 <div class="hero-copy"><p class="eyebrow">For distributors, importers & procurement teams</p><h1>Surgical instruments.<br> Built around your<br> sourcing needs.</h1><p class="lead">Explore our instrument range, discuss private-label requirements and request a quotation directly from our team in <%= business.address.city %>.</p><div class="actions"><a class="button" href="/products">Explore instruments <%- include('partials/icon',{name:'arrow-right'}) %></a><a class="button outline" href="/request-quote">Request a quote <%- include('partials/icon',{name:'request-quote'}) %></a></div><div class="hero-note"><span class="line-mark" aria-hidden="true"></span><span>A direct route from instrument selection to business enquiry.</span></div></div>
 <div class="hero-visual"><% if(heroProduct){ %><div class="hero-visual-top"><span>From the instrument range</span><span><%= [heroProduct.pattern,heroProduct.length].filter(Boolean).join(' / ') %></span></div><% if(heroProduct.image){ %><img class="hero-instrument" src="<%= heroProduct.code==='010-070-13'?'/images/optimized/hero-grazil.webp':heroProduct.image %>" alt="<%= heroProduct.alt || heroProduct.name %>" width="220" height="546" fetchpriority="high"><% } %><% if(heroProduct.length){ %><div class="hero-measure" aria-hidden="true"><span><%= heroProduct.length %></span></div><% } %><div class="hero-visual-bottom"><div><span><%= heroProduct.name %></span><code>REF. <%= heroProduct.code %></code></div><a href="/products/<%= encodeURIComponent(heroProduct.slug) %>" aria-label="View <%= heroProduct.name %>">↗</a></div><% }else{ %><div class="hero-visual-bottom"><a href="/products#catalogues">Browse catalogues ↗</a></div><% } %></div>
</section>
<div class="buyer-strip"><div class="container"><span>A sourcing partner for</span><span>Distributors & wholesalers</span><span>OEM & private-label buyers</span><span>Procurement teams</span></div></div>
<section class="section container">
 <div class="section-heading"><div><p class="eyebrow">Our instrument range</p><h2>Find your starting point.</h2></div><a class="text-link" href="/products">Explore all instruments <%- include('partials/icon',{name:'arrow-right'}) %></a></div>
 <div class="category-grid"><% for(const c of categories.slice(0,4)){ %><a class="category-card" href="/products?category=<%= c.slug || c.id %>"><div class="category-image"><% if(c.imageUrl || c.image){ %><img src="<%= c.imageUrl || (c.image?'/images/optimized/'+c.image+'-480.webp':'/images/optimized/surgical-480.webp') %>"  sizes="(max-width: 600px) 90vw, (max-width: 1000px) 45vw, 25vw" alt="<%= c.name %> range illustration" width="480" height="320" loading="lazy"><% }else{ %><span class="category-placeholder">Explore this range</span><% } %></div><div class="category-caption"><div class="category-name"><%- include('partials/icon',{name:c.slug || c.id}) %><h3><%= c.name %></h3></div><%- include('partials/icon',{name:'arrow-right'}) %></div><span class="muted">Browse range & catalogue</span></a><% } %></div>
 <a class="single-use" href="/products?category=single-use"><%- include('partials/icon',{name:'single-use',size:'large'}) %><div><strong>Looking for single-use instruments?</strong><span>Explore the dedicated catalogue and share your requirements.</span></div><%- include('partials/icon',{name:'arrow-right'}) %></a>
</section>
<section class="section soft"><div class="container"><div class="section-heading"><div><p class="eyebrow">Inside the catalogue</p><h2>Details that make sourcing easier.</h2></div><p class="section-intro">Reference numbers, documented dimensions and a quote list you can build at your own pace.</p></div><div class="featured-grid"><% for(const p of products.filter(p=>p.featured).sort((a,b)=>a.priority-b.priority).slice(0,3)){ %><%- include('partials/product-card',{p}) %><% } %></div><p class="small-note">Selected records from our supplied catalogue. Availability and final specifications are confirmed with your quotation.</p></div></section>
<section class="section container sourcing"><div><p class="eyebrow">OEM & private label</p><h2>Your requirements.<br> A focused conversation.</h2><p class="lead">Building a range under your own brand? Bring us your instrument references, branding requirements and target market.</p><a class="text-link" href="/oem-private-label">Discuss your project <%- include('partials/icon',{name:'arrow-right'}) %></a></div><div class="requirement-list"><div><span>01</span><div><h3><%- include('partials/icon',{name:'reference'}) %>Instrument selection</h3><p>Start with catalogue references or an existing specification.</p></div></div><div><span>02</span><div><h3><%- include('partials/icon',{name:'oem'}) %>Branding & packaging requirements</h3><p>Describe the marking and presentation your business needs.</p></div></div><div><span>03</span><div><h3><%- include('partials/icon',{name:'worldwide'}) %>Quantities & destination</h3><p>Discuss feasibility, samples and order terms with our team.</p></div></div></div></section>
<section class="quality-band"><div class="container quality-inner"><div><p class="eyebrow">Quality & documentation</p><h2>Make an informed<br> sourcing decision.</h2></div><div><p>Documentation should relate to the instrument you’re buying and the market you supply. Ask our team for the applicable specifications and supporting documents before placing an order.</p><a class="text-link" href="/quality">Explore documentation guidance <%- include('partials/icon',{name:'arrow-right'}) %></a></div></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">How to source</p><h2>From selection to quotation.</h2></div><p class="section-intro">No account required. No retail checkout.<br> Just the information needed to move forward.</p></div><ol class="process"><li><span>01</span><h3>Explore the range</h3><p>Browse instruments or open a category catalogue. Note the references you need.</p></li><li><span>02</span><h3>Share your requirements</h3><p>Add instruments to your quote list, then include quantities and business details.</p></li><li><span>03</span><h3>Confirm the details</h3><p>Discuss specifications, documentation, availability and commercial terms with our team.</p></li></ol></section>
<section class="section soft"><div class="container faq-layout"><div><p class="eyebrow">Buyer questions</p><h2>Before you enquire.</h2><p>Need something more specific?</p><a class="text-link" href="mailto:<%= business.email %>">Contact our team <%- include('partials/icon',{name:'arrow-right'}) %></a></div><div class="faq"><% for(const [q,a] of [['Can I request a quotation without an account?','Yes. Add instruments to your quote list or enter your references directly in the enquiry form. Include your company, country and business email.'],['What if I cannot find an instrument online?','The online selection covers a small part of the supplied catalogues. Browse the PDF catalogues or send the product name, reference or specification in your enquiry.'],['Can I discuss private-label requirements?','Yes. Tell us about your branding, packaging and instrument requirements. Our team will confirm what can be supported, including any sample and quantity conditions.'],['Where can I find order quantities and lead times?','Minimum quantities, sample availability and lead times depend on the instrument and requirements. Request these details with your quotation; no fixed terms are assumed.'],['How do I request quality documents?','Include your product references and destination market in a documentation enquiry. Ask for current documents relevant to those products before confirming an order.']]){ %><details><summary><%= q %><span aria-hidden="true">+</span></summary><p><%= a %></p></details><% } %></div></div></section>
<%- include('partials/cta') %>
