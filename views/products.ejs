<section class="container page-intro"><p class="eyebrow">Instrument catalogue</p><h1>Find the right reference.</h1><p class="lead">Explore selected surgical instruments or browse the full PDF catalogues.<br> Build a quote list, then tell us what your business needs.</p></section>
<section class="container catalogue-layout">
 <aside class="catalogue-sidebar"><h2>Instrument ranges</h2><a href="/products" <%- !category?'aria-current="page"':'' %>>All online instruments <span><%= products.length %></span></a><% for(const c of categories){ %><a href="/products?category=<%= c.id %>" <%- category===c.id?'aria-current="page"':'' %>><%= c.name %><span><%= products.filter(p=>p.category===c.id).length || 'PDF' %></span></a><% } %><div class="sidebar-help"><h3>Have your own product list?</h3><p>Send references directly. You don’t need to find every item online.</p><a class="text-link" href="/request-quote">Enquire directly ↗</a></div></aside>
 <div class="catalogue-results"><form class="search-form" action="/products" method="get" role="search"><input type="hidden" name="category" value="<%= category %>"><div><label for="q">Search by instrument or reference</label><div class="search-input"><input id="q" name="q" type="search" placeholder="e.g. scalpel handle or 003-004-00" value="<%= q %>" maxlength="160"><button class="button" type="submit">Search</button></div></div><div><label for="type">Instrument type</label><select id="type" name="type"><option value="">All types</option><% for(const t of ['Scalpel handles','Scissors']){ %><option <%- type===t?'selected':'' %>><%= t %></option><% } %></select></div><button class="filter-button" type="submit">Apply filters</button></form>
 <div class="results-heading"><p><strong><%= results.length %></strong> <%= results.length===1?'instrument found':'instruments found' %><% if(q){ %> for “<%= q %>”<% } %></p><% if(q||type){ %><a href="/products<%= category?'?category='+encodeURIComponent(category):'' %>">Clear search & filters</a><% }else{ %><span>Selected catalogue records</span><% } %></div>
 <% if(results.length){ %><div class="product-grid"><% for(const p of results){ %><%- include('partials/product-card',{p}) %><% } %></div><p class="small-note">Catalogue illustrations shown. Final availability and specifications are confirmed during quotation.</p><% } else { %><div class="empty-state"><h2><%= category&&category!=='surgical'?'No online records in this range yet.':'No matching instruments.' %></h2><p>Try a shorter name or reference, open the category catalogue below, or send us your requirements directly.</p><div class="actions"><a class="button" href="/request-quote?intent=catalogue">Ask about an instrument</a><a class="button outline" href="/products">View online instruments</a></div></div><% } %>
 </div>
</section>
<section class="section soft" id="catalogues"><div class="container"><div class="section-heading"><div><p class="eyebrow">Reference library</p><h2>Browse the supplied catalogues.</h2></div><p class="section-intro">Use the references in your enquiry. Current availability, specifications and document revisions should be confirmed with our team.</p></div><div class="download-list"><% for(const c of categories){ %><a href="/documents/<%= c.pdf %>" target="_blank" rel="noopener"><span><%= c.name %></span><span>PDF · <%= c.pages %> pages <span class="sr-only">opens in a new tab</span><b aria-hidden="true">↗</b></span></a><% } %></div></div></section>
<%- include('partials/cta') %>
