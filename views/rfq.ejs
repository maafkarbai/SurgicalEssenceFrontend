<section class="container page-intro"><p class="eyebrow">Business enquiries</p><h1>Let’s talk instruments.</h1><p class="lead">Tell us what you’re sourcing. Include references, quantities and any specific requirements.<br> No account needed.</p></section>
<section class="container rfq-layout section-topless"><form id="rfq-form" action="/request-quote" method="post" novalidate>
 <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="requestId" value="<%= requestId %>"><input type="hidden" name="items" id="quote-items" value="<%= typeof values.items==='string'?values.items:'[]' %>">
 <div class="honeypot" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off"></div>
 <div id="form-errors" class="error-summary" role="alert" tabindex="-1" <%- Object.keys(errors).length?'':'hidden' %>><h2>Please review your enquiry.</h2><ul><% for(const [field,error] of Object.entries(errors)){ %><li><a href="#<%= field %>"><%= error %></a></li><% } %></ul></div>
 <fieldset><legend><span>01</span> Your business</legend><p class="field-help">Fields marked * are required.</p><div class="form-grid">
 <% for(const [name,label,autocomplete,type] of [['name','Full name','name','text'],['company','Company name','organization','text'],['email','Business email','email','email'],['country','Country','country-name','text']]){ %><div class="field"><label for="<%= name %>"><%= label %> *</label><input id="<%= name %>" name="<%= name %>" type="<%= type %>" autocomplete="<%= autocomplete %>" required maxlength="<%= name==='email'?254:name==='company'?180:name==='country'?100:120 %>" value="<%= typeof values[name]==='string'?values[name]:'' %>" aria-describedby="<%= name %>-error" <%- errors[name]?'aria-invalid="true"':'' %>><span class="field-error" id="<%= name %>-error"><%= errors[name]||'' %></span></div><% } %>
 <div class="field full"><label for="buyerType">Buyer type *</label><select id="buyerType" name="buyerType" required aria-describedby="buyerType-error" <%- errors.buyerType?'aria-invalid="true"':'' %>><option value="">Select your business type</option><% for(const b of buyerTypes){ %><option <%- values.buyerType===b?'selected':'' %>><%= b %></option><% } %></select><span class="field-error" id="buyerType-error"><%= errors.buyerType||'' %></span></div></div></fieldset>
 <fieldset><legend><span>02</span> Your instruments</legend><div id="rfq-quote-summary"></div><div class="field"><label for="products">Product names or reference numbers *</label><textarea id="products" name="products" rows="3" maxlength="5000" aria-describedby="products-help products-error" <%- errors.products?'aria-invalid="true"':'' %> placeholder="e.g. Scalpel handle No. 4, 003-004-00"><%= typeof values.products==='string'?values.products:'' %></textarea><span class="field-help" id="products-help">Enter your requirements here, or include instruments from your quote list.</span><span class="field-error" id="products-error"><%= errors.products||'' %></span></div><div class="field"><label for="quantities">Estimated quantities <span>(optional)</span></label><input id="quantities" name="quantities" maxlength="1000" value="<%= typeof values.quantities==='string'?values.quantities:'' %>" placeholder="e.g. 100 units per reference; samples first"><span class="field-error" id="quantities-error"><%= errors.quantities||'' %></span></div>
 <details class="oem-details" <%- values.oem?'open':'' %>><summary>OEM or private-label requirements <span aria-hidden="true">+</span></summary><div class="field"><label for="oem">Branding, marking or packaging needs <span>(optional)</span></label><textarea id="oem" name="oem" rows="3" maxlength="3000"><%= typeof values.oem==='string'?values.oem:'' %></textarea><span class="field-error" id="oem-error"><%= errors.oem||'' %></span></div></details></fieldset>
 <fieldset><legend><span>03</span> Additional details</legend><div class="field"><label for="message">Message or product specifications <span>(optional)</span></label><textarea id="message" name="message" rows="4" maxlength="8000" placeholder="Destination market, documentation needs, sample requirements or questions for our team."><%= typeof values.message==='string'?values.message:'' %></textarea><span class="field-error" id="message-error"><%= errors.message||'' %></span></div><p class="field-help">Need to share drawings or a product list? Mention it here. Our team can arrange a suitable way to receive your files.</p></fieldset>
 <p class="privacy-note">Your details will be used to handle this business enquiry. Read our <a href="/privacy">privacy notice</a>.</p><button class="button submit-button" type="submit">Send quotation request <span aria-hidden="true">↗</span></button><p class="field-help" id="submit-status" role="status"></p>
 </form><aside class="rfq-aside"><div><h2>A useful enquiry starts here.</h2><ul><li>Exact references help us identify the right instruments.</li><li>Estimated quantities help frame the quotation.</li><li>Your destination tells us which documentation to discuss.</li></ul><p>Availability, specifications, samples and order terms are confirmed individually.</p></div><div><h2>Prefer email?</h2><a href="mailto:info@surgicalessence.com">info@surgicalessence.com</a><p><a href="tel:+923036029756">+92 303 602 9756</a></p><span>Sialkot, Pakistan</span></div></aside></section>
