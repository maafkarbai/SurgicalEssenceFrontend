<!doctype html><html lang="en"><head><meta name="color-scheme" content="light"><meta name="theme-color" content="#ffffff"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Press releases · Surgical Essence Admin</title><link rel="stylesheet" href="/styles.css"></head><body><main class="container section"><a href="/admin">Admin dashboard</a><h1>Press releases</h1><% if(error){ %><p role="alert"><%= error %></p><% } %><h2><%= item.id?'Edit release':'New release' %></h2><p>Content is plain text. Drafts are visible only in the administrator area.</p>
<form method="post" action="/admin/press-releases/save"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(item.id){ %><input type="hidden" name="id" value="<%= item.id %>"><input type="hidden" name="revision" value="<%= item.revision %>"><% } %><p><label>Title <input name="title" value="<%= item.title||'' %>" required maxlength="200"></label></p><p><label>Slug <input name="slug" value="<%= item.slug||'' %>" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="160"></label></p><p><label>Content <textarea name="content" rows="12" required maxlength="50000"><%= item.content||'' %></textarea></label></p><p><label>Status <select name="status"><option value="draft" <%= item.status!=='published'?'selected':'' %>>Draft</option><option value="published" <%= item.status==='published'?'selected':'' %>>Published</option></select></label></p><button type="submit">Save release</button> <a href="/admin/press-releases">New release</a></form>
<h2>All releases</h2><% if(!items.length){ %><p>No releases yet.</p><% } %><% for(const release of items){ %><article><h3><%= release.title %></h3><p><%= release.status %> · revision <%= release.revision %></p><a href="/admin/press-releases/<%= release.id %>/edit">Edit</a><% if(release.status==='published'){ %> · <a href="/press-releases/<%= release.slug %>">View published release</a><% } %><form method="post" action="/admin/press-releases/<%= release.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= release.revision %>"><button type="submit">Delete release</button></form></article><% } %></main></body></html>
