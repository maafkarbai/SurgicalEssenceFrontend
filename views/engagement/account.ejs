<section class="container section"><h1>Buyer account</h1><p>Signed in as <%= buyer.name %> (<%= buyer.email %>).</p><% if(error){ %><p role="alert"><%= error %></p><% } %>
<form method="post" action="/account/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit">Sign out</button></form>
<h2>Your quotation history</h2><p>Only new requests submitted while signed in appear here. A reference confirms receipt of an enquiry; it does not confirm a price or order.</p>
<% if(!history.items.length){ %><p>No account quotation requests yet.</p><% }else{ %><p><%= history.total %> quotation request<%= history.total===1?'':'s' %> · Page <%= history.page %> of <%= history.pages %></p><ol start="<%= (history.page-1)*history.limit+1 %>"><% for(const quote of history.items){ %><li><article><h3><%= quote.reference %></h3><time datetime="<%= new Date(quote.createdAt).toISOString() %>"><%= new Date(quote.createdAt).toISOString().slice(0,10) %></time><p>Status: <%= ({NEW:'New enquiry',CONTACTED:'Contacted',NEGOTIATION:'In discussion',CLOSED:'Closed'})[quote.status] %></p><% if(quote.summary){ %><p><%= quote.summary %></p><% } %><% if(quote.items.length){ %><ul><% for(const item of quote.items){ %><li>Reference <%= item.code %> · Quantity <%= item.quantity %></li><% } %></ul><% } %><% if(quote.message){ %><h4>Your message</h4><p><%= quote.message %></p><% } %></article></li><% } %></ol><nav aria-label="Quotation history pages"><% if(history.page>1){ %><a href="/account?page=<%= history.page-1 %>" rel="prev">Previous page</a><% } %> <% if(history.page<history.pages){ %><a href="/account?page=<%= history.page+1 %>" rel="next">Next page</a><% } %></nav><% } %>
<p><a class="button" href="/request-quote">Request a quotation</a></p>
<h2>Change password</h2><form method="post" action="/account/password"><input type="hidden" name="_csrf" value="<%= csrf %>"><p><label>Current password <input type="password" name="currentPassword" autocomplete="current-password" required maxlength="256"></label></p><p><label>New password <input type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="256"></label></p><p>Changing your password signs out all account sessions.</p><button type="submit">Change password</button></form></section>
