<section class="container section"><h1>Press releases</h1><p>Published updates from Surgical Essence.</p><% if(!items.length){ %><p>No press releases have been published yet.</p><% } %><% for(const item of items){ %><article><h2><a href="/press-releases/<%= item.slug %>"><%= item.title %></a></h2><time datetime="<%= new Date(item.publishedAt).toISOString() %>"><%= new Date(item.publishedAt).toISOString().slice(0,10) %></time><p><%= item.content.slice(0,220) %></p></article><% } %></section>
