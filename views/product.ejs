<section class="container detail-layout" itemscope itemtype="https://schema.org/Product">
 <div class="detail-visual"><% if(product.image){ %><img itemprop="image" src="<%= product.image %>" <% if(product.images?.[0]?.mediumUrl){ %>srcset="<%= product.images[0].smallUrl %> 400w, <%= product.images[0].mediumUrl %> 800w, <%= product.image %> 1600w" sizes="(max-width: 640px) 90vw, 45vw"<% } %> alt="<%= product.images?.[0]?.alt || product.alt || product.name %>" width="440" height="600"><% }else{ %><p>Image not yet available.</p><% } %><% if(product.page){ %><p>Illustration from the supplied surgical catalogue.</p><% } %><% if(product.images?.length>1){ %><div class="product-gallery"><% for(const image of product.images.slice(1)){ %><a href="<%= image.url %>" target="_blank" rel="noopener"><img src="<%= image.smallUrl || image.url %>" alt="<%= image.alt || product.name %>" width="120" height="120"></a><% } %></div><% } %></div>
 <div class="detail-copy"><p class="eyebrow"><%= product.type || 'Instrument details' %></p><h1 itemprop="name"><%= product.name %></h1><p class="reference"><%- include('partials/icon',{name:'reference',size:'small'}) %> Reference <code itemprop="sku"><%= product.code %></code></p><p itemprop="description"><%= product.shortDescription || (product.page ? 'An instrument listed in the Surgical Essence surgical catalogue. Use this reference to discuss quantities and sourcing requirements.' : 'Discuss this instrument and your sourcing requirements with our team.') %></p><% if(product.description){ %><div class="product-description"><h2>Product information</h2><p><%= product.description %></p></div><% } %><table class="spec-table"><caption><%= product.page?'Catalogue specifications':'Technical information' %></caption><tbody><% for(const [label,value] of [['Instrument type',product.type],['Pattern',product.pattern],['Size / dimensions',product.length],['Reference number',product.code],['Material / finish',product.material],['Variations',product.variations],['Specifications',product.specifications],['Technical notes',product.notes]]){ if(value){ %><tr><th scope="row"><%= label %></th><td><%= value %></td></tr><% }} %><tr><th scope="row">Availability & order quantity</th><td>Confirmed with quotation</td></tr></tbody></table><div class="actions"><button class="button" data-add="<%= product.code %>" data-name="<%= product.name %>" data-slug="<%= product.slug || product.code %>" data-image="<%= product.image || '' %>">Add to quote list <%- include('partials/icon',{name:'quote-list'}) %></button><a class="button outline" href="/quote-list">Review quote list</a></div><noscript><p>To request this instrument without JavaScript, enter <%= product.code %> on the <a href="/request-quote">quotation form</a>.</p></noscript><% if(product.page){ %><a class="document-link" href="/documents/surgical.pdf#page=<%= product.page %>" target="_blank" rel="noopener"><%- include('partials/icon',{name:'catalogue'}) %> View source catalogue · PDF page <%= product.page %> <span aria-hidden="true">↗</span><span class="sr-only"> opens in a new tab</span></a><% } %></div>
</section>
<section class="section soft"><div class="container detail-notes"><div><h2>Confirm the details before you order.</h2><p>Ask about available variants, material, finish, reprocessing information and applicable documentation for your destination market. A catalogue entry is not a statement of regulatory approval or current stock.</p><a class="text-link" href="/quality">Quality & documentation ↗</a></div><div><h2>Need a different pattern?</h2><p>Share another catalogue reference or describe the instrument you need. For private-label projects, include marking and packaging requirements.</p><a class="text-link" href="/request-quote">Send your requirements ↗</a></div></div></section>
<% if(typeof related!=='undefined'&&related.length){ %><section class="container section"><div class="section-heading"><div><p class="eyebrow">Explore the range</p><h2>Related instruments</h2></div></div><div class="product-grid"><% for(const p of related){ %><%- include('partials/product-card',{p}) %><% } %></div></section><% } %>
<%- include('partials/cta') %>
