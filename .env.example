PORT=3000
SITE_URL=http://localhost:3000
DATA_DIR=./data
# Set to production only behind HTTPS. Use a persistent private data directory.
NODE_ENV=development
# Configure exactly the number of trusted reverse proxies; default is 0.
TRUST_PROXY_HOPS=0
# Optional email alerts. Accepted requests are always stored in SQLite first.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RFQ_FROM=
RFQ_TO=info@surgicalessence.com
# Vercel CMS: existing PostgreSQL URL; never use ephemeral local media in production.
DATABASE_URL=
DIRECT_URL=
# Exact public Blob store hostname, without https:// (required with the Blob token).
BLOB_PUBLIC_HOST=
BLOB_READ_WRITE_TOKEN=
# Optional independent 32+ character random session/CSRF secret. Keep private.
CSRF_SECRET=

# Bulk import limits may be lowered; hard safety ceilings remain in code.
CMS_IMPORT_MAX_ROWS=10000
CMS_IMPORT_MAX_CSV_BYTES=4194304
CMS_IMPORT_MAX_ZIP_BYTES=67108864
CMS_IMPORT_ACTIVE_LIMIT=20
# Optional verified WhatsApp business number, international digits only.
# Leave blank to hide the WhatsApp link. No placeholder contact is used.
WHATSAPP_NUMBER=
