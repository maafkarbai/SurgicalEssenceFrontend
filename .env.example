PORT=3000
SITE_URL=http://localhost:3000
DATA_DIR=./data
# Set to production only behind HTTPS. Use a persistent private data directory.
NODE_ENV=development
# Configure exactly the number of trusted reverse proxies; default is 0.
TRUST_PROXY_HOPS=0
# Optional email alerts. Accepted requests are always stored in SQLite first.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RFQ_FROM=
RFQ_TO=info@surgicalessence.com
