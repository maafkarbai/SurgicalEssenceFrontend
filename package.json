{
  "name": "surgical-essence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:build": "node scripts/build-icons.js",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.js",
    "check": "node --check server.js && node --check src/app.js && node --check public/app.js"
  },
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "ejs": "^7.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "pg-mem": "^3.0.14",
    "playwright": "^1.55.0",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
