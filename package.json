{
  "name": "surgical-essence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.js",
    "check": "node --check server.js && node --check src/app.js && node --check public/app.js"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "pg-mem": "^3.0.14",
    "playwright": "^1.55.0",
    "supertest": "^7.1.4"
  }
}
